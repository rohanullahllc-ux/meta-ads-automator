# Two separate places hold configuration. Neither real file is ever committed.

# 1) web/.env  (read by the browser app; only public values belong here)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=   # the "publishable" key. Never put the secret/service_role key here.

# 2) supabase/.env.functions  (server-side secrets for the Edge Functions)
#    Set with: npx supabase secrets set --env-file supabase/.env.functions
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v25.0
APP_ORIGINS=http://localhost:5173
TOKEN_ENCRYPTION_KEY=   # 32 random bytes, base64:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
STATE_SIGNING_KEY=      # same format, a different value
# META_LOGIN_CONFIG_ID=  # only for "Facebook Login for Business" apps
